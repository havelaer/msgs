{
  "name": "@havelaer/msgs",
  "version": "0.0.19",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./functions": {
      "types": "./dist/functions.d.ts",
      "import": "./dist/functions.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/havelaer/msgs.git"
  },
  "keywords": [
    "messageformat",
    "MessageFormat2",
    "MF2",
    "l10n",
    "localization",
    "react",
    "typescript"
  ],
  "scripts": {
    "check": "biome check .",
    "release": "npm run check && tsc && npm version patch -m 'chore: bump version %s'",
    "postrelease": "git push && git push --tags",
    "build": "tsdown",
    "test": "vitest --coverage"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.5",
    "happy-dom": "^20.9.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsdown": "^0.22.2",
    "typescript": "~6.0.1",
    "vitest": "^4.1.5"
  },
  "workspaces": [
    ".",
    "playground"
  ],
  "dependencies": {
    "messageformat": "4.0.0"
  }
}
